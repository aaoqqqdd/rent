{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rent",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.html", "**/*.css", "**/*.txt"],
			"fallthrough": true
		}
	],
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"vars": {
		// 允许独立部署的营销官网 rent-web 跨站调用 POST /public/rental-request。
		// 只放行这一个 origin；不配置则该接口一律返回 403。
		"PUBLIC_WEB_ORIGIN": "https://rent-web.ydnw6zt6vj.workers.dev"
	},
	// 注意：secret（TURNSTILE_SECRET_KEY 等，用 `wrangler secret put` 设的）不受影响；
	// 若 rent 还有别的「明文」变量只配在 Dashboard 里，部署前要一并补进上面的 vars，
	// 否则 config 会成为明文变量的唯一来源，Dashboard 里多出来的会被清掉。
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	"d1_databases": [
		{
			"binding": "RENT",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93"
		},
		{
			"binding": "rent",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93",
			"remote": true
		},
	],
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	// "ai": {
	//   "binding": "AI"
	// },
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}
