{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rent",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.html", "**/*.css", "**/*.txt"],
			"fallthrough": true
		}
	],
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"vars": {
		// 仅允许已部署的营销官网跨站提交购物车订单。
		"PUBLIC_WEB_ORIGIN": "https://rent-web.ydnw6zt6vj.workers.dev"
	},
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	"d1_databases": [
		{
			"binding": "RENT",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93"
		},
		{
			"binding": "rent",
			"database_name": "rent",
			"database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93",
			"remote": true
		},
	],
	"triggers": {
		// "0 0 * * *" runs the full daily maintenance batch; "0 * * * *" only
		// cancels expired pending-payment orders so the 24h SLA isn't stretched
		// to ~48h by the once-a-day sweep (see scheduled() in src/index.ts).
		"crons": ["0 0 * * *", "0 * * * *"]
	},
	// "ai": {
	//   "binding": "AI"
	// },
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}
