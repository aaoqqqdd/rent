{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rent-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "RENT",
      "database_name": "rent",
      "database_id": "65a5ded3-ffd8-4627-8ea4-9d8ced480b93"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
